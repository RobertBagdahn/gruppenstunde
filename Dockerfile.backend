# Backend – Cloud Run
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GUNICORN_WORKERS=2 \
    GUNICORN_THREADS=4

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      gcc libpq-dev libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
      libgdk-pixbuf-2.0-0 shared-mime-info fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/pyproject.toml ./
RUN pip install --no-cache-dir uv && \
    uv pip install --system --no-cache ".[dev]" || \
    uv pip install --system --no-cache .

COPY backend/ ./

RUN python -c 'from weasyprint import HTML; pdf = HTML(string="<p>PDF runtime smoke test</p>").write_pdf(); assert pdf.startswith(b"%PDF-")'

RUN python manage.py collectstatic --noinput 2>/dev/null || true

EXPOSE 8000

CMD ["sh", "-c", "exec gunicorn inspi.wsgi:application --bind 0.0.0.0:8000 --workers \"$GUNICORN_WORKERS\" --threads \"$GUNICORN_THREADS\" --timeout 300"]
