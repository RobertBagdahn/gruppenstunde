# Copy to backend/.env and adjust. backend/.env is git-ignored; never commit real values.

# v1 DuckDB (source system, read-only). Default: <repo>/data/seed_demand.duckdb
# V1_DUCKDB_PATH=/absolute/path/to/data/seed_demand.duckdb

# Derived store, deleted by `make nuke`. Default: backend/var/ruebert.duckdb
# DERIVED_DB_PATH=backend/var/ruebert.duckdb

# Decision journal (Git-versioned). Default: <repo>/journal
# JOURNAL_DIR=journal

# Date the app treats as "today". Default: 2026-05-18 (Monday after the last v1 booking)
# REFERENCE_DATE=2026-05-18

# Feedback button: fine-grained token for RobertBagdahn/seed-demand with "Issues: write" only.
# GITHUB_TOKEN=
# GITHUB_REPO=RobertBagdahn/seed-demand
# GITHUB_ASSIGNEE=RobertBagdahn
