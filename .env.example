# Django
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_SETTINGS_MODULE=inspi.settings.local

# Database (matches docker-compose.yml)
DB_NAME=inspi
DB_USER=inspi
DB_PASSWORD=inspi
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email Configuration (SMTP/Gmail)
EMAIL_HOST_USER=inspirator.testmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here

# Google GenAI (get key from https://aistudio.google.com/apikey)
GOOGLE_GENAI_API_KEY=

# GCP
# GOOGLE_CLOUD_PROJECT=your-project-id
# GCS_BUCKET_NAME=inspi-media
# APPENGINE_URL=https://gruppenstunde.de

# Social login (OAuth). Only providers with a client id are offered.
# Redirect URI per provider and domain:
#   http://localhost:5173/api/accounts/<provider>/login/callback/   (main frontend)
#   http://localhost:5174/api/accounts/<provider>/login/callback/   (food frontend)
#   https://gruppenstunde.de/api/accounts/<provider>/login/callback/
#   https://essensplan.app/api/accounts/<provider>/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_PRIVATE_KEY=
# Local login without provider (never in production)
AUTH_DEV_LOGIN_ENABLED=true

# AI budgets (EUR)
AI_BUDGET_ANONYMOUS_EUR_PER_HOUR=0.05
AI_BUDGET_ANONYMOUS_VISITOR_EUR_PER_HOUR=0.02
AI_BUDGET_USER_EUR_PER_DAY=0.30
AI_BUDGET_STAFF_EUR_PER_DAY=3.00
